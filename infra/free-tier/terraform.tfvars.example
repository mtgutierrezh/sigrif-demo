project     = "sigrif"
environment = "prod"
aws_region  = "us-east-2"

instance_type = "t3.micro"

# DuckDNS: crear el subdominio en https://www.duckdns.org y pegar el token.
duckdns_subdomain = "sigrif-demo"
duckdns_token     = "CAMBIAR"

# Correo para Let's Encrypt y alertas.
letsencrypt_email = "equipo7@example.com"
alert_email       = "equipo7@example.com"
budget_email      = "equipo7@example.com"

github_repository = "mtgutierrezh/sigrif-demo"

# Solo si los paquetes GHCR son privados. El token necesita read:packages.
ghcr_username = ""
ghcr_token    = ""
