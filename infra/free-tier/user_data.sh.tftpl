#!/bin/bash
set -euxo pipefail

exec > >(tee /var/log/sigrif-bootstrap.log | logger -t sigrif-bootstrap -s 2>/dev/console) 2>&1

dnf update -y
dnf install -y docker unzip curl

systemctl enable --now docker
usermod -aG docker ec2-user

COMPOSE_VERSION="v2.29.7"
mkdir -p /usr/local/lib/docker/cli-plugins
curl -fsSL "https://github.com/docker/compose/releases/download/$COMPOSE_VERSION/docker-compose-linux-x86_64" \
  -o /usr/local/lib/docker/cli-plugins/docker-compose
chmod +x /usr/local/lib/docker/cli-plugins/docker-compose

if ! command -v aws >/dev/null 2>&1; then
  curl -fsSL "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" -o /tmp/awscliv2.zip
  unzip -q /tmp/awscliv2.zip -d /tmp
  /tmp/aws/install
fi

if [ ! -f /swapfile ]; then
  fallocate -l 2G /swapfile || dd if=/dev/zero of=/swapfile bs=1M count=2048
  chmod 600 /swapfile
  mkswap /swapfile
  swapon /swapfile
  grep -q '^/swapfile' /etc/fstab || echo '/swapfile none swap sw 0 0' >> /etc/fstab
fi

mkdir -p /opt/sigrif/artifacts /opt/sigrif/nginx/upstream /opt/sigrif/certbot/www /opt/sigrif/certbot/conf
chown -R ec2-user:ec2-user /opt/sigrif

TOKEN=$(curl -fsS -X PUT "http://169.254.169.254/latest/api/token" \
  -H "X-aws-ec2-metadata-token-ttl-seconds: 21600")
PUBLIC_IP=$(curl -fsS -H "X-aws-ec2-metadata-token: $TOKEN" \
  http://169.254.169.254/latest/meta-data/public-ipv4)

DB_PASSWORD=$(aws ssm get-parameter \
  --name "${db_password_parameter}" \
  --with-decryption \
  --query Parameter.Value \
  --output text \
  --region "${aws_region}")

DUCKDNS_TOKEN=""
if [ -n "${duckdns_token_parameter}" ]; then
  DUCKDNS_TOKEN=$(aws ssm get-parameter \
    --name "${duckdns_token_parameter}" \
    --with-decryption \
    --query Parameter.Value \
    --output text \
    --region "${aws_region}")
fi

GHCR_TOKEN=$(aws ssm get-parameter \
  --name "${ghcr_token_parameter}" \
  --with-decryption \
  --query Parameter.Value \
  --output text \
  --region "${aws_region}")

if [ "${ghcr_username}" != "" ] && [ "$GHCR_TOKEN" != "unused" ]; then
  printf '%s' "$GHCR_TOKEN" > /opt/sigrif/ghcr_token
  chmod 600 /opt/sigrif/ghcr_token
  chown ec2-user:ec2-user /opt/sigrif/ghcr_token
fi

APP_ORIGIN="${app_origin}"
if [ -z "$APP_ORIGIN" ]; then
  APP_ORIGIN="http://$PUBLIC_IP"
fi

cat > /opt/sigrif/.env <<EOF
POSTGRES_DB=${db_name}
POSTGRES_USER=${db_user}
POSTGRES_PASSWORD=$DB_PASSWORD
DATABASE_URL=postgresql+psycopg://${db_user}:$DB_PASSWORD@db:5432/${db_name}
AWS_REGION=${aws_region}
AWS_ENDPOINT_URL=
MESSAGING_ENABLED=false
APP_COLOR=blue
AUTH_ENABLED=true
COGNITO_REGION=${cognito_region}
COGNITO_USER_POOL_ID=${cognito_user_pool_id}
COGNITO_CLIENT_ID=${cognito_client_id}
CORS_ORIGINS=$APP_ORIGIN
S3_BUCKET=${s3_bucket}
BEDROCK_ENABLED=true
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
GHCR_USERNAME=${ghcr_username}
DOMAIN=${fqdn}
LETSENCRYPT_EMAIL=${letsencrypt_email}
EOF

chmod 600 /opt/sigrif/.env
chown ec2-user:ec2-user /opt/sigrif/.env

if [ -n "${duckdns_subdomain}" ] && [ -n "$DUCKDNS_TOKEN" ]; then
cat > /usr/local/bin/sigrif-duckdns.sh <<EOF
#!/bin/bash
curl -fsS "https://www.duckdns.org/update?domains=${duckdns_subdomain}&token=$DUCKDNS_TOKEN&ip=" \
  > /var/log/sigrif-duckdns.log 2>&1
EOF
chmod 700 /usr/local/bin/sigrif-duckdns.sh

cat > /etc/systemd/system/sigrif-duckdns.service <<'EOF'
[Unit]
Description=Actualizar la IP publica de SIGRIF en DuckDNS
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/sigrif-duckdns.sh
EOF

cat > /etc/systemd/system/sigrif-duckdns.timer <<'EOF'
[Unit]
Description=Actualizar DuckDNS cada cinco minutos

[Timer]
OnBootSec=1min
OnUnitActiveSec=5min
Persistent=true

[Install]
WantedBy=timers.target
EOF

systemctl daemon-reload
systemctl enable --now sigrif-duckdns.timer
/usr/local/bin/sigrif-duckdns.sh || true
fi

if [ -n "${letsencrypt_email}" ] && [ -n "${fqdn}" ]; then
cat > /usr/local/bin/sigrif-renew-certs.sh <<'EOF'
#!/bin/bash
set -euo pipefail
cd /opt/sigrif/release
docker compose -f docker-compose.prod.yml --env-file /opt/sigrif/.env --profile tools \
  run --rm certbot renew --webroot -w /var/www/certbot
docker compose -f docker-compose.prod.yml --env-file /opt/sigrif/.env \
  exec -T nginx nginx -s reload
EOF
chmod 700 /usr/local/bin/sigrif-renew-certs.sh

cat > /etc/systemd/system/sigrif-renew-certs.service <<'EOF'
[Unit]
Description=Renovar certificados TLS de SIGRIF
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/sigrif-renew-certs.sh
EOF

cat > /etc/systemd/system/sigrif-renew-certs.timer <<'EOF'
[Unit]
Description=Renovar certificados TLS dos veces al dia

[Timer]
OnCalendar=*-*-* 03,15:15:00
RandomizedDelaySec=15min
Persistent=true

[Install]
WantedBy=timers.target
EOF

systemctl daemon-reload
systemctl enable --now sigrif-renew-certs.timer
fi

systemctl enable --now amazon-ssm-agent || true
touch /var/lib/sigrif-bootstrap-complete
