POSTGRES_DB=sigrif
POSTGRES_USER=sigrif
POSTGRES_PASSWORD=change-me
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SNS_TOPIC_ARN=
SQS_QUEUE_URL=
MESSAGING_ENABLED=true
APP_COLOR=local
LOG_LEVEL=INFO
AUTH_ENABLED=false
COGNITO_REGION=
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
IA_URL=http://localhost:8001
SIGRIF_MODEL_PATH=artifacts/risk_model.joblib
SIGRIF_MODEL_S3_URI=
S3_BUCKET=

# OCR de fichas de terreno con Amazon Bedrock. En local se deja deshabilitado
# porque no hay credenciales AWS. En EC2 se habilita con el rol IAM de la
# instancia (sin claves en el archivo).
BEDROCK_ENABLED=false
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
OCR_MAX_BYTES=5242880
OCR_MAX_TOKENS=1500
DOMAIN=
LETSENCRYPT_EMAIL=

# Build del frontend servido por Nginx. Para el despliegue se pasan como
# build args desde GitHub Actions; en local se pueden dejar vacíos para
# trabajar sin Cognito o completar con el pool de la cuenta.
VITE_API_BASE_URL=
VITE_COGNITO_AUTHORITY=
VITE_COGNITO_CLIENT_ID=
VITE_COGNITO_REDIRECT_URI=

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# Mensajería y alertas (producción)
ALERT_TOPIC_ARN=
ALERT_COOLDOWN_HOURS=6

# Ingesta meteorológica
INGEST_ENABLED=false
INGEST_PROVIDER=auto
INGEST_INTERVAL_SECONDS=900
INGEST_STATION_RADIUS_KM=80
DMC_USER=
DMC_TOKEN=
DMC_URL=https://climatologia.meteochile.gob.cl/application/servicios/getDatosRecientesRedEma
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
